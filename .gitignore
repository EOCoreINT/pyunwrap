# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
build/
dist/
.eggs/

# --- Virtual environments ---
.venv/
venv/
env/

# --- Testing / coverage / linting ---
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml

# --- Jupyter ---
.ipynb_checkpoints/

# --- OS ---
.DS_Store
Thumbs.db

# --- Editors / IDEs ---
.vscode/
.idea/
*.swp

# --- pyunwrap-specific artifacts ---
# Trained model weights, ONNX exports, and the local Zenodo weight cache
# (pyunwrap.utils.deployment.ModelCache defaults to ~/.pyunwrap/models, which
# is outside the repo, but a local override might land here during dev).
*.onnx
*.onnx.data
*.pt
*.pth
.pyunwrap/

# Generated synthetic/training data and tiled HDF5 datasets -- these are
# regenerated by pyunwrap.synthetic.generator / pyunwrap.data.preprocessing,
# not checked into source control.
*.h5
*.hdf5

# Training run outputs (checkpoints, TensorBoard logs, matplotlib plots) --
# see pyunwrap.training.trainer.Trainer's out_dir.
runs/
tensorboard/

# Generated GeoTIFF rasters and HTML reports from example/test runs.
*.tif
*.tiff
report/
assets/*.html

# Local test scratch space
/tmp_test_data/
